# Development Supabase project — REQUIRED catalog source (read-only via RLS).
#
# Supabase is the only catalog source; there is no static fallback. Both vars
# are required — if either is missing the app fails fast with a clear error.
# Copy this file to .env.local and fill in your dev project values. Both vars
# are NEXT_PUBLIC_* and safe for the browser (anon/publishable key, gated by RLS).
#
# Find these in: Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SERVER-ONLY Supabase key used by Route Handlers/Server Actions for
# validated cart mutations. Never expose this in the browser and never prefix
# it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Catalog admin bootstrap — local operator input only. Set exactly one verified
# non-production identity and one role only when intentionally running
# `pnpm admin:bootstrap`; do not promote an arbitrary account.
HELIX_ADMIN_USER_ID=
# HELIX_ADMIN_EMAIL=verified-operator@example.com
HELIX_ADMIN_ROLE=catalog_editor

# Public application URL used to build Supabase Auth email redirects.
# Local: http://localhost:3000
# Vercel staging (`dev`): https://helixskin.vercel.app
# Use only an exact, project-controlled HTTPS origin outside local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Catalog setup (schema + seed) is applied via the Supabase migrations
# "catalog" and "seed_catalog" (re-runnable through the Supabase MCP
# apply_migration tool). The e2e suite verifies the catalog is seeded before
# running and fails fast with instructions if it is not.
#
# Account/cart setup:
#   Apply supabase/migrations/202606180001_account_and_cart.sql only to a
#   verified development Supabase project.
#   Required Auth redirect URLs:
#     http://localhost:3000/auth/callback
#     http://localhost:3000/auth/confirm
#     https://helixskin.vercel.app/auth/callback
#     https://helixskin.vercel.app/auth/confirm
#     https://<production-domain>/auth/callback
#     https://<production-domain>/auth/confirm
#   Email confirmation and password recovery should point to /auth/callback
#   (or /auth/confirm for token_hash templates). Configure custom SMTP before
#   production launch; do not commit SMTP credentials.

# ---------------------------------------------------------------------------
# Algolia — searchable catalog cache (Search + Discovery v1)
# ---------------------------------------------------------------------------
# Supabase stays the source of truth; Algolia is a synced search cache. The
# storefront searches Algolia (never Supabase) for interactive search.
#
# PUBLIC (browser-safe) — used by the client search path. The search key MUST
# be a Search-only API key, never the admin key.
NEXT_PUBLIC_ALGOLIA_APP_ID=your-algolia-app-id
NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=your-search-only-api-key
NEXT_PUBLIC_ALGOLIA_INDEX_NAME=helix_products

# SERVER-ONLY (never expose to the client) — used by the sync webhook and the
# admin reindex route to WRITE to the index. Do NOT prefix these with
# NEXT_PUBLIC_. The write key needs addObject/deleteObject/settings ACLs.
ALGOLIA_APP_ID=your-algolia-app-id
ALGOLIA_WRITE_API_KEY=your-admin-or-write-api-key
# ALGOLIA_ADMIN_API_KEY is accepted as an alternative to ALGOLIA_WRITE_API_KEY.
ALGOLIA_INDEX_NAME=helix_products

# Migration-only control-plane access. The admin key is required only for
# Product Search apply/finalize so all scoped keys can be inventoried; never
# add it to Vercel or a browser bundle. Set the one Analytics region configured
# for this Algolia application so Query Suggestions inventory is authoritative.
ALGOLIA_ADMIN_API_KEY=
ALGOLIA_QUERY_SUGGESTIONS_REGION=us

# Shared secret guarding the catalog sync webhook and the admin reindex route.
# Generate a random value (e.g. `openssl rand -hex 32`). The Supabase Database
# Webhook must send it as the HTTP header: x-webhook-secret: <this value>.
SUPABASE_CATALOG_WEBHOOK_SECRET=generate-a-long-random-secret

# Catalog Database Webhook provisioning. These values are for the local
# operator command only; SUPABASE_ACCESS_TOKEN must not be added to Vercel or
# committed. The project ref is deliberately fixed to the approved
# non-production project, and production is rejected by the command.
SUPABASE_PROJECT_REF=erasogmsqpgiirovubjh
CATALOG_WEBHOOK_TARGET_ENVIRONMENT=development
SUPABASE_ACCESS_TOKEN=your-supabase-management-api-access-token
SUPABASE_CATALOG_WEBHOOK_URL=https://helixskin.vercel.app/api/webhooks/supabase/catalog-search-sync
# Required when that non-production Vercel deployment uses Deployment
# Protection. The provisioner sends this only as an HTTP header and redacts its
# value from plan/verification reports.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Existing non-production product UUID used only by the synthetic delivery
# smoke check. The smoke sends a child-table payload; it does not change this
# product or any canonical Supabase row.
CATALOG_WEBHOOK_SMOKE_PRODUCT_ID=

# Required safety declaration for the backfill command/route. Vercel supplies
# VERCEL_ENV automatically; local CLI use must set this explicitly.
SEARCH_BACKFILL_ENVIRONMENT=development
# Production reindex remains blocked unless this is intentionally set to true.
ALLOW_PRODUCTION_SEARCH_REINDEX=false

# Supabase -> Algolia/cache webhook provisioning:
#   pnpm catalog:webhooks:plan
#   pnpm catalog:webhooks:apply   # final integration only
#   pnpm catalog:webhooks:verify
#   pnpm catalog:webhooks:smoke   # controlled non-production verification
# The source-controlled workflow manages all seven governed Catalog tables for
# INSERT, UPDATE, and DELETE.
# After setup, catalog changes sync automatically — no manual script needed.
# For initial backfill or recovery after an index reset (NOT the normal path):
#   pnpm run search:backfill
# Or, from a running app:
#   curl -X POST http://localhost:3000/api/admin/search-reindex \
#     -H "x-webhook-secret: $SUPABASE_CATALOG_WEBHOOK_SECRET"
# Note: remote provisioning requires a stable HTTPS endpoint. Supabase cannot
# reach localhost; local route behavior remains covered by automated tests.
#
# Algolia index migration and canonical reconciliation:
#   pnpm product:search:plan
#   pnpm product:search:apply
#   pnpm product:search:verify
#   pnpm product:search:finalize   # runs deployed webhook verification first

# ---------------------------------------------------------------------------
# Stripe sandbox checkout — NO LIVE MODE
# ---------------------------------------------------------------------------
# Checkout is sandbox-only in this repository. Use Stripe test/sandbox keys and
# never commit real values. The app refuses live keys and live webhook events.
CHECKOUT_MODE=sandbox
CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=sk_test_replace_with_sandbox_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_sandbox_publishable
STRIPE_WEBHOOK_SECRET=whsec_replace_with_sandbox_webhook_secret
STRIPE_WEBHOOK_ENDPOINT_ID=
STRIPE_STANDARD_SHIPPING_RATE_ID=shr_replace_with_sandbox_fixed_usd_rate
STRIPE_AUTOMATIC_TAX_ENABLED=false

# Created or verified by: pnpm stripe:sync:sandbox
STRIPE_REWARD_200_COUPON_ID=
STRIPE_REWARD_400_COUPON_ID=
STRIPE_REWARD_600_COUPON_ID=
STRIPE_REFERRAL_15_COUPON_ID=

# Local Stripe webhook forwarding:
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
# Test cards and sandbox Checkout must come from Stripe's official test docs.
