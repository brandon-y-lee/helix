# Development Supabase project — REQUIRED catalog source (read-only via RLS).
#
# Supabase is the only catalog source; there is no static fallback. Both vars
# are required — if either is missing the app fails fast with a clear error.
# Copy this file to .env.local and fill in your dev project values. Both vars
# are NEXT_PUBLIC_* and safe for the browser (anon/publishable key, gated by RLS).
#
# Find these in: Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Catalog setup (schema + seed) is applied via the Supabase migrations
# "catalog" and "seed_catalog" (re-runnable through the Supabase MCP
# apply_migration tool). The e2e suite verifies the catalog is seeded before
# running and fails fast with instructions if it is not.

# ---------------------------------------------------------------------------
# Algolia — searchable catalog cache (Search + Discovery v1)
# ---------------------------------------------------------------------------
# Supabase stays the source of truth; Algolia is a synced search cache. The
# storefront searches Algolia (never Supabase) for interactive search.
#
# PUBLIC (browser-safe) — used by the client search path. The search key MUST
# be a Search-only API key, never the admin key.
NEXT_PUBLIC_ALGOLIA_APP_ID=your-algolia-app-id
NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=your-search-only-api-key
NEXT_PUBLIC_ALGOLIA_INDEX_NAME=mei_pelle_products

# SERVER-ONLY (never expose to the client) — used by the sync webhook and the
# admin reindex route to WRITE to the index. Do NOT prefix these with
# NEXT_PUBLIC_. The write key needs addObject/deleteObject/settings ACLs.
ALGOLIA_APP_ID=your-algolia-app-id
ALGOLIA_WRITE_API_KEY=your-admin-or-write-api-key
ALGOLIA_INDEX_NAME=mei_pelle_products

# Shared secret guarding the catalog sync webhook and the admin reindex route.
# Generate a random value (e.g. `openssl rand -hex 32`). The Supabase Database
# Webhook must send it as the HTTP header: x-webhook-secret: <this value>.
SUPABASE_CATALOG_WEBHOOK_SECRET=generate-a-long-random-secret

# Supabase -> Algolia webhook setup (Dashboard -> Database -> Webhooks):
#   1) Create a webhook on table "products" for INSERT, UPDATE, DELETE.
#   2) Create a webhook on table "product_variants" for INSERT, UPDATE, DELETE.
#   3) Type: HTTP Request. URL: https://<your-app>/api/webhooks/supabase/catalog-search-sync
#   4) Add HTTP header  x-webhook-secret: <SUPABASE_CATALOG_WEBHOOK_SECRET>.
# After setup, product changes sync automatically — no manual script needed.
# For initial backfill or recovery after an index reset (NOT the normal path):
#   curl -X POST http://localhost:3000/api/admin/search-reindex \
#     -H "x-webhook-secret: $SUPABASE_CATALOG_WEBHOOK_SECRET"
# Note: Supabase cannot reach http://localhost; for local webhook testing use a
# tunnel (e.g. ngrok) or rely on the reindex route above for dev.
