CREATE TABLE private.support_ai_jobs (
    id uuid NOT NULL,
    inquiry_id uuid NOT NULL,
    actor_id uuid,
    inquiry_revision integer NOT NULL,
    draft_version integer NOT NULL,
    approval_id uuid,
    message_id uuid NOT NULL,
    facts jsonb NOT NULL,
    state text DEFAULT 'queued'::text NOT NULL,
    lease_token uuid,
    expires_at timestamp with time zone DEFAULT (clock_timestamp() + '00:05:00'::interval) NOT NULL,
    draft_id uuid,
    reference_ids text[] DEFAULT '{}'::text[] NOT NULL,
    needs_human boolean,
    runtime jsonb,
    error_code text,
    created_at timestamp with time zone DEFAULT clock_timestamp() NOT NULL,
    finished_at timestamp with time zone,
    redacted_at timestamp with time zone,
    CONSTRAINT support_ai_jobs_check CHECK (((state = 'running'::text) = (lease_token IS NOT NULL))),
    CONSTRAINT support_ai_jobs_check1 CHECK (((state = 'completed'::text) = (draft_id IS NOT NULL))),
    CONSTRAINT support_ai_jobs_draft_version_check CHECK ((draft_version >= 0)),
    CONSTRAINT support_ai_jobs_inquiry_revision_check CHECK ((inquiry_revision > 0)),
    CONSTRAINT support_ai_jobs_state_check CHECK ((state = ANY (ARRAY['queued'::text, 'running'::text, 'completed'::text, 'failed'::text, 'cancelled'::text, 'stale'::text])))
);

ALTER TABLE ONLY private.support_ai_jobs FORCE ROW LEVEL SECURITY;

