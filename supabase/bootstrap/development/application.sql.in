CREATE SCHEMA private;

CREATE TYPE public.cart_status AS ENUM (
    'active',
    'merged',
    'abandoned'
);

CREATE TYPE public.checkout_environment AS ENUM (
    'sandbox'
);

CREATE TYPE public.order_status AS ENUM (
    'draft',
    'pending_payment',
    'paid',
    'payment_failed',
    'cancelled',
    'refunded'
);

CREATE TYPE public.payment_attempt_status AS ENUM (
    'requires_payment',
    'processing',
    'paid',
    'failed',
    'cancelled',
    'refunded'
);

CREATE TYPE public.private_feedback_status AS ENUM (
    'available',
    'submitted',
    'rewarded',
    'void'
);

CREATE TYPE public.referral_reward_status AS ENUM (
    'available',
    'reserved',
    'consumed',
    'void'
);

CREATE TYPE public.referral_status AS ENUM (
    'pending',
    'qualified',
    'rewarded',
    'void'
);

CREATE TYPE public.rewards_ledger_entry_type AS ENUM (
    'welcome',
    'purchase_earn',
    'purchase_refund',
    'redemption_reserved',
    'redemption_captured',
    'redemption_released',
    'redemption_reversal',
    'referral_entitlement_issued',
    'referral_entitlement_reserved',
    'referral_entitlement_consumed',
    'referral_entitlement_released',
    'private_feedback',
    'manual_adjustment'
);

CREATE TYPE public.rewards_ledger_status AS ENUM (
    'pending',
    'posted',
    'void'
);

CREATE TYPE public.rewards_reservation_status AS ENUM (
    'pending',
    'applied',
    'void',
    'reversed'
);

CREATE TYPE public.trustpilot_invitation_status AS ENUM (
    'blocked_private_feedback_only'
);

CREATE TABLE private.support_inbound_jobs (
    id uuid DEFAULT extensions.gen_random_uuid() NOT NULL,
    provider_email_id text NOT NULL,
    inquiry_id uuid,
    recipient text NOT NULL,
    sender text NOT NULL,
    route_kind text NOT NULL,
    routing_ambiguous boolean DEFAULT false NOT NULL,
    state text DEFAULT 'pending'::text NOT NULL,
    received_at timestamp with time zone NOT NULL,
    created_at timestamp with time zone DEFAULT clock_timestamp() NOT NULL,
    updated_at timestamp with time zone DEFAULT clock_timestamp() NOT NULL,
    next_attempt_at timestamp with time zone DEFAULT clock_timestamp() NOT NULL,
    deadline_at timestamp with time zone DEFAULT (clock_timestamp() + '00:55:00'::interval) NOT NULL,
    attempt_count integer DEFAULT 0 NOT NULL,
    generation integer DEFAULT 1 NOT NULL,
    lease_token uuid,
    lease_expires_at timestamp with time zone,
    payload jsonb,
    reason text,
    participant_matches boolean DEFAULT false NOT NULL,
    accept_allowed boolean DEFAULT false NOT NULL,
    message_id uuid,
    redacted_at timestamp with time zone,
    CONSTRAINT support_inbound_jobs_attempt_count_check CHECK (((attempt_count >= 0) AND (attempt_count <= 5))),
    CONSTRAINT support_inbound_jobs_check CHECK (((lease_token IS NULL) = (lease_expires_at IS NULL))),
    CONSTRAINT support_inbound_jobs_check1 CHECK (((state = 'accepted'::text) = (message_id IS NOT NULL))),
    CONSTRAINT support_inbound_jobs_provider_email_id_check CHECK (((length(provider_email_id) >= 1) AND (length(provider_email_id) <= 200))),
    CONSTRAINT support_inbound_jobs_route_kind_check CHECK ((route_kind = ANY (ARRAY['alias'::text, 'base'::text]))),
    CONSTRAINT support_inbound_jobs_state_check CHECK ((state = ANY (ARRAY['pending'::text, 'leased'::text, 'quarantined'::text, 'failed'::text, 'accepted'::text, 'dismissed'::text])))
);

ALTER TABLE ONLY private.support_inbound_jobs FORCE ROW LEVEL SECURITY;

