CREATE TABLE private.catalog_media_operations (
    operation_id uuid NOT NULL,
    manifest jsonb NOT NULL,
    result jsonb NOT NULL,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT catalog_media_operations_manifest_check CHECK ((jsonb_typeof(manifest) = 'object'::text)),
    CONSTRAINT catalog_media_operations_result_check CHECK ((jsonb_typeof(result) = 'object'::text))
);

CREATE TABLE private.catalog_media_policy (
    singleton boolean DEFAULT true NOT NULL,
    enabled boolean DEFAULT false NOT NULL,
    operation_id uuid,
    activated_at timestamp with time zone,
    activated_by uuid,
    CONSTRAINT catalog_media_policy_check CHECK ((((NOT enabled) AND (operation_id IS NULL) AND (activated_at IS NULL) AND (activated_by IS NULL)) OR (enabled AND (operation_id IS NOT NULL) AND (activated_at IS NOT NULL) AND (activated_by IS NOT NULL)))),
    CONSTRAINT catalog_media_policy_singleton_check CHECK (singleton)
);

CREATE TABLE private.checkout_admission_budgets (
    account_id text NOT NULL,
    environment public.checkout_environment DEFAULT 'sandbox'::public.checkout_environment NOT NULL,
    budget_key text NOT NULL,
    accepted_at timestamp with time zone[] DEFAULT '{}'::timestamp with time zone[] NOT NULL,
    CONSTRAINT checkout_admission_budgets_accepted_at_check CHECK ((cardinality(accepted_at) <= 30)),
    CONSTRAINT checkout_admission_budgets_account_id_check CHECK ((account_id ~ '^acct_[A-Za-z0-9_]{1,128}$'::text)),
    CONSTRAINT checkout_admission_budgets_environment_check CHECK ((environment = 'sandbox'::public.checkout_environment))
);

ALTER TABLE ONLY private.checkout_admission_budgets FORCE ROW LEVEL SECURITY;

CREATE TABLE private.checkout_create_receipts (
    account_id text NOT NULL,
    environment public.checkout_environment DEFAULT 'sandbox'::public.checkout_environment NOT NULL,
    idempotency_key text NOT NULL,
    order_id uuid NOT NULL,
    owner_key text NOT NULL,
    admitted_at timestamp with time zone NOT NULL,
    session_id text,
    CONSTRAINT checkout_create_receipts_account_id_check CHECK ((account_id ~ '^acct_[A-Za-z0-9_]{1,128}$'::text)),
    CONSTRAINT checkout_create_receipts_environment_check CHECK ((environment = 'sandbox'::public.checkout_environment)),
    CONSTRAINT checkout_create_receipts_idempotency_key_check CHECK (((char_length(idempotency_key) >= 1) AND (char_length(idempotency_key) <= 255)))
);

ALTER TABLE ONLY private.checkout_create_receipts FORCE ROW LEVEL SECURITY;

CREATE TABLE private.checkout_legacy_contracts (
    order_id uuid NOT NULL,
    session_id text NOT NULL,
    terms jsonb NOT NULL,
    created_at timestamp with time zone DEFAULT now() NOT NULL
);

ALTER TABLE ONLY private.checkout_legacy_contracts FORCE ROW LEVEL SECURITY;

CREATE TABLE private.checkout_legacy_order_origins (
    order_id uuid NOT NULL,
    stripe_idempotency_key text,
    terms jsonb NOT NULL,
    created_at timestamp with time zone DEFAULT now() NOT NULL
);

ALTER TABLE ONLY private.checkout_legacy_order_origins FORCE ROW LEVEL SECURITY;

CREATE TABLE private.checkout_payment_contracts (
    attempt_id uuid NOT NULL,
    order_id uuid NOT NULL,
    terms jsonb NOT NULL,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT checkout_payment_contracts_terms_check CHECK ((jsonb_typeof(terms) = 'object'::text))
);

ALTER TABLE ONLY private.checkout_payment_contracts FORCE ROW LEVEL SECURITY;

CREATE TABLE private.checkout_payment_exceptions (
    id uuid DEFAULT extensions.gen_random_uuid() NOT NULL,
    order_id uuid NOT NULL,
    attempt_id uuid,
    session_id text NOT NULL,
    account_id text DEFAULT 'acct_1Tm9WRFEzyaKzdmq'::text NOT NULL,
    environment text DEFAULT 'sandbox'::text NOT NULL,
    code text NOT NULL,
    payment_intent_id text,
    payment_status text NOT NULL,
    amount_cents integer,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    resolved_at timestamp with time zone,
    CONSTRAINT checkout_payment_exceptions_account_id_check CHECK ((account_id = 'acct_1Tm9WRFEzyaKzdmq'::text)),
    CONSTRAINT checkout_payment_exceptions_amount_cents_check CHECK (((amount_cents IS NULL) OR (amount_cents >= 0))),
    CONSTRAINT checkout_payment_exceptions_code_check CHECK ((code = ANY (ARRAY['invalid_contract'::text, 'provider_context_mismatch'::text, 'session_identity_mismatch'::text, 'payment_identity_mismatch'::text, 'payment_state_mismatch'::text, 'unsupported_zero_total'::text, 'line_items_mismatch'::text, 'discount_mismatch'::text, 'shipping_mismatch'::text, 'tax_mismatch'::text, 'unsupported_tax_behavior'::text, 'amount_mismatch'::text, 'missing_shipping_address'::text, 'missing_contract'::text, 'side_effects_failed'::text, 'finalization_failed'::text, 'settlement_effects_failed'::text, 'full_refund_reconciliation_failed'::text]))),
    CONSTRAINT checkout_payment_exceptions_environment_check CHECK ((environment = 'sandbox'::text)),
    CONSTRAINT checkout_payment_exceptions_payment_intent_id_check CHECK (((payment_intent_id IS NULL) OR (payment_intent_id ~ '^pi_[A-Za-z0-9_]{1,200}$'::text))),
    CONSTRAINT checkout_payment_exceptions_payment_status_check CHECK ((payment_status = ANY (ARRAY['paid'::text, 'unpaid'::text, 'no_payment_required'::text, 'refunded'::text, 'unknown'::text]))),
    CONSTRAINT checkout_payment_exceptions_session_id_check CHECK ((session_id ~ '^cs_[A-Za-z0-9_]{1,200}$'::text))
);

ALTER TABLE ONLY private.checkout_payment_exceptions FORCE ROW LEVEL SECURITY;

CREATE TABLE private.checkout_provider_sends (
