CREATE TABLE private.support_photos (
    id uuid DEFAULT extensions.gen_random_uuid() NOT NULL,
    inquiry_id uuid NOT NULL,
    message_id uuid NOT NULL,
    submission_id uuid,
    upload_id uuid,
    source text NOT NULL,
    raw_path text,
    clean_path text NOT NULL,
    provider_email_id text,
    attachment_id text,
    expected_bytes bigint NOT NULL,
    expected_type text NOT NULL,
    state text DEFAULT 'pending'::text NOT NULL,
    upload_completed boolean DEFAULT false NOT NULL,
    upload_expires_at timestamp with time zone,
    token_mint_deadline_at timestamp with time zone,
    token_mint_count integer DEFAULT 0 NOT NULL,
    charged_bytes bigint,
    clean_bytes bigint,
    width integer,
    height integer,
    rejection_reason text,
    attempt_count integer DEFAULT 0 NOT NULL,
    next_attempt_at timestamp with time zone DEFAULT clock_timestamp() NOT NULL,
    deadline_at timestamp with time zone DEFAULT (clock_timestamp() + '24:00:00'::interval) NOT NULL,
    lease_token uuid,
    lease_expires_at timestamp with time zone,
    last_processing_until timestamp with time zone,
    raw_delete_requested_at timestamp with time zone,
    clean_delete_requested_at timestamp with time zone,
    raw_deleted_at timestamp with time zone,
    clean_deleted_at timestamp with time zone,
    cleanup_lease_token uuid,
    cleanup_lease_expires_at timestamp with time zone,
    cleanup_next_attempt_at timestamp with time zone DEFAULT clock_timestamp() NOT NULL,
    created_at timestamp with time zone DEFAULT clock_timestamp() NOT NULL,
    updated_at timestamp with time zone DEFAULT clock_timestamp() NOT NULL,
    CONSTRAINT support_photos_attempt_count_check CHECK (((attempt_count >= 0) AND (attempt_count <= 5))),
    CONSTRAINT support_photos_charged_bytes_check CHECK (((charged_bytes >= 1) AND (charged_bytes <= 10485760))),
    CONSTRAINT support_photos_check CHECK ((((source = 'upload'::text) AND (submission_id IS NOT NULL) AND (upload_id IS NOT NULL) AND (raw_path IS NOT NULL) AND (provider_email_id IS NULL) AND (attachment_id IS NULL)) OR ((source = 'resend'::text) AND (submission_id IS NULL) AND (upload_id IS NULL) AND (raw_path IS NULL) AND (provider_email_id IS NOT NULL) AND (attachment_id IS NOT NULL) AND upload_completed))),
    CONSTRAINT support_photos_check1 CHECK (((lease_token IS NULL) = (lease_expires_at IS NULL))),
    CONSTRAINT support_photos_check2 CHECK (((cleanup_lease_token IS NULL) = (cleanup_lease_expires_at IS NULL))),
    CONSTRAINT support_photos_check3 CHECK (((state <> 'ready'::text) OR ((charged_bytes IS NOT NULL) AND (clean_bytes IS NOT NULL) AND (width IS NOT NULL) AND (height IS NOT NULL)))),
    CONSTRAINT support_photos_check4 CHECK (((state <> 'rejected'::text) OR (rejection_reason IS NOT NULL))),
    CONSTRAINT support_photos_check5 check((source='resend' and state='rejected') or
    (expected_bytes between 1 and 10485760 and expected_type in ('image/jpeg','image/png','image/webp'))),
    CONSTRAINT support_photos_clean_bytes_check CHECK (((clean_bytes >= 1) AND (clean_bytes <= 4194304))),
    CONSTRAINT support_photos_expected_bytes_check CHECK (((expected_bytes >= 0) AND (expected_bytes <= '9007199254740991'::bigint))),
    CONSTRAINT support_photos_expected_type_check CHECK (((length(expected_type) >= 1) AND (length(expected_type) <= 128))),
    CONSTRAINT support_photos_height_check CHECK (((height >= 1) AND (height <= 2560))),
    CONSTRAINT support_photos_rejection_reason_check CHECK ((rejection_reason = ANY (ARRAY['invalid_image'::text, 'too_large'::text, 'processing_timeout'::text, 'storage_unavailable'::text, 'expired'::text]))),
    CONSTRAINT support_photos_source_check CHECK ((source = ANY (ARRAY['upload'::text, 'resend'::text]))),
    CONSTRAINT support_photos_state_check CHECK ((state = ANY (ARRAY['pending'::text, 'processing'::text, 'ready'::text, 'rejected'::text]))),
    CONSTRAINT support_photos_token_mint_count_check CHECK (((token_mint_count >= 0) AND (token_mint_count <= 5))),
    CONSTRAINT support_photos_width_check CHECK (((width >= 1) AND (width <= 2560)))
);

ALTER TABLE ONLY private.support_photos FORCE ROW LEVEL SECURITY;

CREATE TABLE private.support_reply_approvals (
    id uuid DEFAULT extensions.gen_random_uuid() NOT NULL,
    inquiry_id uuid NOT NULL,
    draft_id uuid NOT NULL,
    inquiry_revision integer NOT NULL,
    actor_id uuid,
    message_id uuid NOT NULL,
    email_intent_id uuid NOT NULL,
    created_at timestamp with time zone DEFAULT clock_timestamp() NOT NULL
);

ALTER TABLE ONLY private.support_reply_approvals FORCE ROW LEVEL SECURITY;

CREATE TABLE private.support_reply_routes (
    inquiry_id uuid NOT NULL,
    address text NOT NULL,
    created_at timestamp with time zone DEFAULT clock_timestamp() NOT NULL,
    CONSTRAINT support_reply_routes_address_check CHECK (((length(address) >= 3) AND (length(address) <= 254)))
);

ALTER TABLE ONLY private.support_reply_routes FORCE ROW LEVEL SECURITY;

CREATE TABLE private.support_rfc_conflicts (
    email_intent_id uuid NOT NULL,
    reason text DEFAULT 'message_id_conflict'::text NOT NULL,
    created_at timestamp with time zone DEFAULT clock_timestamp() NOT NULL,
    CONSTRAINT support_rfc_conflicts_reason_check CHECK ((reason = 'message_id_conflict'::text))
);

ALTER TABLE ONLY private.support_rfc_conflicts FORCE ROW LEVEL SECURITY;

CREATE TABLE private.support_rfc_messages (
    rfc_message_id text NOT NULL,
    inquiry_id uuid NOT NULL,
    provider_email_id text NOT NULL,
    email_intent_id uuid,
    message_id uuid,
    origin text NOT NULL,
    created_at timestamp with time zone DEFAULT clock_timestamp() NOT NULL,
    CONSTRAINT support_rfc_messages_origin_check CHECK ((origin = ANY (ARRAY['incoming'::text, 'outgoing'::text]))),
    CONSTRAINT support_rfc_messages_rfc_message_id_check CHECK (((length(rfc_message_id) >= 3) AND (length(rfc_message_id) <= 512)))
);

ALTER TABLE ONLY private.support_rfc_messages FORCE ROW LEVEL SECURITY;

CREATE TABLE private.support_upload_batches (
    submission_id uuid NOT NULL,
    inquiry_id uuid NOT NULL,
    message_id uuid NOT NULL,
    capability_hash text NOT NULL,
    source_hash text NOT NULL,
    email_hash text NOT NULL,
    manifest jsonb NOT NULL,
    created_at timestamp with time zone DEFAULT clock_timestamp() NOT NULL,
    redacted_at timestamp with time zone,
    CONSTRAINT support_upload_batches_capability_hash_check CHECK ((capability_hash ~ '^[0-9a-f]{64}$'::text)),
    CONSTRAINT support_upload_batches_email_hash_check CHECK ((email_hash ~ '^[0-9a-f]{64}$'::text)),
    CONSTRAINT support_upload_batches_manifest_check CHECK (private.valid_support_photo_manifest(manifest)),
    CONSTRAINT support_upload_batches_source_hash_check CHECK ((source_hash ~ '^[0-9a-f]{64}$'::text))
);

ALTER TABLE ONLY private.support_upload_batches FORCE ROW LEVEL SECURITY;

CREATE TABLE private.verified_media_copies (
    product_id uuid NOT NULL,
    source_url text NOT NULL,
    target_url text NOT NULL,
    sha256 text NOT NULL,
    byte_size bigint NOT NULL,
    mime_type text NOT NULL,
    width integer NOT NULL,
    height integer NOT NULL,
    source_object_id uuid NOT NULL,
    source_object_version text NOT NULL,
    target_object_id uuid NOT NULL,
    target_object_version text NOT NULL,
    operation_id uuid NOT NULL,
    verified_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT verified_media_copies_byte_size_check CHECK ((byte_size > 0)),
    CONSTRAINT verified_media_copies_height_check CHECK ((height > 0)),
    CONSTRAINT verified_media_copies_sha256_check CHECK ((sha256 ~ '^[0-9a-f]{64}$'::text)),
    CONSTRAINT verified_media_copies_width_check CHECK ((width > 0))
);

CREATE TABLE public.admin_memberships (
    user_id uuid NOT NULL,
    role text NOT NULL,
    active boolean DEFAULT true NOT NULL,
    created_by uuid,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT admin_memberships_role_check CHECK ((role = ANY (ARRAY['admin'::text, 'catalog_publisher'::text, 'catalog_editor'::text])))
);

CREATE TABLE public.cart_items (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    cart_id uuid NOT NULL,
    product_id uuid NOT NULL,
    variant_key text NOT NULL,
    quantity integer NOT NULL,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT cart_items_quantity_bounds CHECK (((quantity >= 1) AND (quantity <= 99))),
    CONSTRAINT cart_items_variant_key_present CHECK ((char_length(variant_key) > 0))
);

CREATE TABLE public.carts (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    user_id uuid,
    guest_token_hash text,
    status public.cart_status DEFAULT 'active'::public.cart_status NOT NULL,
    currency text DEFAULT 'USD'::text NOT NULL,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    expires_at timestamp with time zone,
    checkout_generation uuid DEFAULT extensions.gen_random_uuid() NOT NULL,
    CONSTRAINT carts_currency_usd CHECK ((currency = 'USD'::text)),
    CONSTRAINT carts_guest_token_hash_length CHECK (((guest_token_hash IS NULL) OR ((char_length(guest_token_hash) >= 32) AND (char_length(guest_token_hash) <= 128)))),
    CONSTRAINT carts_owner_identity CHECK ((((user_id IS NOT NULL) AND (guest_token_hash IS NULL)) OR ((user_id IS NULL) AND (guest_token_hash IS NOT NULL))))
);

CREATE TABLE public.catalog_editor_audit_log (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    action text NOT NULL,
    actor_id uuid,
    product_id uuid,
    draft_id uuid,
    revision_id uuid,
    metadata jsonb DEFAULT '{}'::jsonb NOT NULL,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT catalog_editor_audit_log_action_check CHECK ((action = ANY (ARRAY['draft.created'::text, 'draft.saved'::text, 'draft.validated'::text, 'draft.ready'::text, 'draft.discarded'::text, 'draft.restored'::text, 'draft.published'::text, 'media.uploaded'::text, 'membership.created'::text, 'membership.updated'::text, 'slug.rename.published'::text, 'slug.replacement.published'::text, 'family.published'::text]))),
    CONSTRAINT catalog_editor_audit_log_metadata_check CHECK ((jsonb_typeof(metadata) = 'object'::text))
);

CREATE TABLE public.catalog_product_revisions (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    product_id uuid NOT NULL,
    revision_number integer NOT NULL,
    schema_version smallint DEFAULT 4 NOT NULL,
    document jsonb NOT NULL,
    source_draft_id uuid,
    published_by uuid,
    published_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT catalog_product_revisions_document_check CHECK (((jsonb_typeof(document) = 'object'::text) AND (((document ->> 'schemaVersion'::text))::smallint = schema_version) AND (schema_version = ANY (ARRAY[1, 2, 3, 4])) AND ((schema_version <> 4) OR (NOT ((document -> 'product'::text) ?| ARRAY['formal_title'::text, 'card_tagline'::text, 'routine_step_number'::text, 'routine_step_name'::text]))))),
    CONSTRAINT catalog_product_revisions_revision_number_check CHECK ((revision_number > 0)),
    CONSTRAINT catalog_product_revisions_schema_version_check CHECK ((schema_version = ANY (ARRAY[1, 2, 3, 4])))
);

CREATE TABLE public.order_items (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    order_id uuid NOT NULL,
    product_id uuid,
    product_slug text NOT NULL,
    product_name text NOT NULL,
    variant_key text NOT NULL,
    variant_label text NOT NULL,
    unit_price_cents integer NOT NULL,
    quantity integer NOT NULL,
    line_subtotal_cents integer NOT NULL,
    product_snapshot jsonb DEFAULT '{}'::jsonb NOT NULL,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT order_items_line_total CHECK ((line_subtotal_cents = (unit_price_cents * quantity))),
    CONSTRAINT order_items_price_nonnegative CHECK (((unit_price_cents >= 0) AND (line_subtotal_cents >= 0))),
    CONSTRAINT order_items_quantity_bounds CHECK (((quantity >= 1) AND (quantity <= 99)))
);

CREATE TABLE public.payment_attempts (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    order_id uuid NOT NULL,
    provider text DEFAULT 'stripe'::text NOT NULL,
    checkout_environment public.checkout_environment DEFAULT 'sandbox'::public.checkout_environment NOT NULL,
    status public.payment_attempt_status DEFAULT 'requires_payment'::public.payment_attempt_status NOT NULL,
    amount_cents integer NOT NULL,
    currency text DEFAULT 'USD'::text NOT NULL,
    stripe_checkout_session_id text,
    stripe_payment_intent_id text,
    idempotency_key text NOT NULL,
    raw_status text,
    last_error text,
    metadata jsonb DEFAULT '{}'::jsonb NOT NULL,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    contract_version text,
    stripe_idempotency_key text,
    CONSTRAINT payment_attempt_contract_version CHECK (((contract_version IS NULL) OR (contract_version = 'checkout_v2'::text))),
    CONSTRAINT payment_attempts_amount_nonnegative CHECK ((amount_cents >= 0)),
    CONSTRAINT payment_attempts_currency_usd CHECK ((currency = 'USD'::text)),
    CONSTRAINT payment_attempts_provider_stripe CHECK ((provider = 'stripe'::text)),
    CONSTRAINT payment_attempts_sandbox_only CHECK ((checkout_environment = 'sandbox'::public.checkout_environment))
);

CREATE TABLE public.private_feedback (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    user_id uuid NOT NULL,
    order_id uuid NOT NULL,
    status public.private_feedback_status DEFAULT 'available'::public.private_feedback_status NOT NULL,
    rating integer,
    comments text,
    points_awarded integer DEFAULT 0 NOT NULL,
    submitted_at timestamp with time zone,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT private_feedback_comments_length CHECK (((comments IS NULL) OR (char_length(comments) <= 2000))),
    CONSTRAINT private_feedback_points_nonnegative CHECK ((points_awarded >= 0)),
    CONSTRAINT private_feedback_rating_range CHECK (((rating IS NULL) OR ((rating >= 1) AND (rating <= 5))))
);

CREATE TABLE public.product_content_drafts (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    product_id uuid NOT NULL,
    schema_version smallint DEFAULT 4 NOT NULL,
    base_revision integer DEFAULT 0 NOT NULL,
    version bigint DEFAULT 1 NOT NULL,
    document jsonb NOT NULL,
    status text DEFAULT 'draft'::text NOT NULL,
    validation_errors jsonb DEFAULT '[]'::jsonb NOT NULL,
    created_by uuid NOT NULL,
    updated_by uuid NOT NULL,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    ready_at timestamp with time zone,
    published_at timestamp with time zone,
    discarded_at timestamp with time zone,
    CONSTRAINT product_content_drafts_base_revision_check CHECK ((base_revision >= 0)),
    CONSTRAINT product_content_drafts_current_schema_check CHECK (((status <> ALL (ARRAY['draft'::text, 'ready'::text])) OR (schema_version = 4))),
    CONSTRAINT product_content_drafts_document_check CHECK (((jsonb_typeof(document) = 'object'::text) AND (((document ->> 'schemaVersion'::text))::smallint = schema_version) AND (schema_version = ANY (ARRAY[1, 2, 3, 4])) AND ((schema_version <> 4) OR (NOT ((document -> 'product'::text) ?| ARRAY['formal_title'::text, 'card_tagline'::text, 'routine_step_number'::text, 'routine_step_name'::text]))))),
    CONSTRAINT product_content_drafts_schema_version_check CHECK ((schema_version = ANY (ARRAY[1, 2, 3, 4]))),
    CONSTRAINT product_content_drafts_status_check CHECK ((status = ANY (ARRAY['draft'::text, 'ready'::text, 'published'::text, 'discarded'::text]))),
    CONSTRAINT product_content_drafts_validation_errors_check CHECK ((jsonb_typeof(validation_errors) = 'array'::text)),
    CONSTRAINT product_content_drafts_version_check CHECK ((version > 0))
);

CREATE TABLE public.product_families (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    slug text NOT NULL,
    display_name text NOT NULL,
    system_step_name text NOT NULL,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT product_families_display_name_check CHECK ((NULLIF(btrim(display_name), ''::text) IS NOT NULL)),
    CONSTRAINT product_families_slug_check CHECK (((slug = btrim(slug)) AND (slug ~ '^[a-z0-9]+(-[a-z0-9]+)*$'::text)))
);

CREATE TABLE public.product_family_memberships (
    family_id uuid NOT NULL,
    product_id uuid NOT NULL,
    option_label text NOT NULL,
    sort_order smallint NOT NULL,
    is_entry boolean DEFAULT false NOT NULL,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT product_family_memberships_option_label_check CHECK ((NULLIF(btrim(option_label), ''::text) IS NOT NULL)),
    CONSTRAINT product_family_memberships_sort_order_check CHECK ((sort_order >= 0))
);

CREATE TABLE public.product_media (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    product_id uuid NOT NULL,
    variant_id uuid,
    media_type text DEFAULT 'image'::text NOT NULL,
    url text,
    alt text NOT NULL,
    width integer,
    height integer,
    role text DEFAULT 'gallery'::text NOT NULL,
    sort_order integer DEFAULT 0 NOT NULL,
    original_source_url text,
    source_filename text,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    palette_id text,
    placeholder_palette jsonb DEFAULT '{}'::jsonb NOT NULL,
    archived_at timestamp with time zone,
    CONSTRAINT product_media_canonical_payload_check CHECK ((((media_type = 'video'::text) AND (NULLIF(url, ''::text) IS NOT NULL) AND (placeholder_palette = '{}'::jsonb)) OR ((media_type = 'image'::text) AND (((NULLIF(url, ''::text) IS NOT NULL) AND (placeholder_palette = '{}'::jsonb)) OR ((url IS NULL) AND (jsonb_typeof(placeholder_palette) = 'object'::text) AND (placeholder_palette ? 'start'::text) AND (placeholder_palette ? 'end'::text) AND ((placeholder_palette ->> 'start'::text) ~* '^#[0-9a-f]{6}$'::text) AND ((placeholder_palette ->> 'end'::text) ~* '^#[0-9a-f]{6}$'::text) AND ((NOT (placeholder_palette ? 'accent'::text)) OR ((placeholder_palette ->> 'accent'::text) ~* '^#[0-9a-f]{6}$'::text)) AND ((NOT (placeholder_palette ? 'surface'::text)) OR ((placeholder_palette ->> 'surface'::text) ~* '^#[0-9a-f]{6}$'::text)) AND ((NOT (placeholder_palette ? 'ink'::text)) OR ((placeholder_palette ->> 'ink'::text) ~* '^#[0-9a-f]{6}$'::text)) AND ((NOT (placeholder_palette ? 'highlight'::text)) OR ((placeholder_palette ->> 'highlight'::text) ~* '^#[0-9a-f]{6}$'::text))))))),
    CONSTRAINT product_media_core_routine_editorial_shape_check CHECK (((role <> 'core_routine_editorial'::text) OR ((media_type = 'image'::text) AND (NULLIF(btrim(url), ''::text) IS NOT NULL) AND (url ~ '^https://zyfkunnpnlmgvrojmrbg[.]supabase[.]co/storage/v1/object/public/helix-catalog/products/[^[:space:]?#]+$'::text) AND (width IS NOT NULL) AND (width > 0) AND (height IS NOT NULL) AND (height > 0) AND (variant_id IS NULL) AND (sort_order = 1) AND (palette_id IS NULL) AND (placeholder_palette = '{}'::jsonb)))),
    CONSTRAINT product_media_editorial_role_type_check CHECK (((role <> ALL (ARRAY['routine_video'::text, 'routine_video_poster'::text, 'profile_editorial'::text, 'ingredients_texture'::text, 'core_routine_texture'::text, 'core_routine_editorial'::text, 'pdp_outcome'::text, 'pdp_application'::text])) OR ((NULLIF(btrim(url), ''::text) IS NOT NULL) AND (width IS NOT NULL) AND (width > 0) AND (height IS NOT NULL) AND (height > 0) AND (((role = 'routine_video'::text) AND (media_type = 'video'::text)) OR ((role = ANY (ARRAY['routine_video_poster'::text, 'profile_editorial'::text, 'ingredients_texture'::text, 'core_routine_texture'::text, 'core_routine_editorial'::text, 'pdp_outcome'::text, 'pdp_application'::text])) AND (media_type = 'image'::text)))))),
    CONSTRAINT product_media_height_check CHECK (((height IS NULL) OR (height > 0))),
    CONSTRAINT product_media_media_type_check CHECK ((media_type = ANY (ARRAY['image'::text, 'video'::text]))),
    CONSTRAINT product_media_role_check CHECK ((role = ANY (ARRAY['card'::text, 'hero'::text, 'gallery'::text, 'detail'::text, 'card_default'::text, 'card_hover'::text, 'cart'::text, 'search'::text, 'routine_video'::text, 'routine_video_poster'::text, 'profile_editorial'::text, 'ingredients_texture'::text, 'core_routine_texture'::text, 'core_routine_editorial'::text, 'pdp_outcome'::text, 'pdp_application'::text]))),
    CONSTRAINT product_media_width_check CHECK (((width IS NULL) OR (width > 0)))
);

CREATE TABLE public.product_pdp_content (
    product_id uuid NOT NULL,
    schema_version smallint DEFAULT 1 NOT NULL,
    profile_title_tokens jsonb,
    routine_overlay text,
    outcome_heading text,
    outcome_labels text[],
    how_to_use_steps text[],
    application_steps text[],
    ingredient_cards jsonb,
    ingredient_story jsonb,
    routine_guidance text,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT product_pdp_content_ingredient_cards_check CHECK (((ingredient_cards IS NULL) OR (jsonb_typeof(ingredient_cards) = 'array'::text))),
    CONSTRAINT product_pdp_content_ingredient_story_check CHECK (((ingredient_story IS NULL) OR (jsonb_typeof(ingredient_story) = 'object'::text))),
    CONSTRAINT product_pdp_content_outcome_labels_check CHECK (((outcome_labels IS NULL) OR (cardinality(outcome_labels) = 3))),
    CONSTRAINT product_pdp_content_profile_title_tokens_check CHECK (((profile_title_tokens IS NULL) OR ((jsonb_typeof(profile_title_tokens) = 'array'::text) AND (jsonb_array_length(profile_title_tokens) > 0)))),
    CONSTRAINT product_pdp_content_schema_version_check CHECK ((schema_version = 1))
);

CREATE TABLE public.product_relationships (
    product_id uuid NOT NULL,
    related_product_id uuid NOT NULL,
    relationship_type text DEFAULT 'complete_the_routine'::text NOT NULL,
    sort_order integer DEFAULT 0 NOT NULL,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    archived_at timestamp with time zone,
    CONSTRAINT product_relationships_not_self CHECK ((product_id <> related_product_id)),
    CONSTRAINT product_relationships_relationship_type_check CHECK ((relationship_type = ANY (ARRAY['complete_the_routine'::text, 'related'::text, 'routine_next'::text])))
);

CREATE TABLE public.product_slug_routes (
    source_slug text NOT NULL,
    source_product_id uuid NOT NULL,
    target_product_id uuid NOT NULL,
    route_kind text NOT NULL,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT product_slug_routes_identity_check CHECK ((((route_kind = ANY (ARRAY['canonical'::text, 'rename'::text])) AND (source_product_id = target_product_id)) OR ((route_kind = 'replacement'::text) AND (source_product_id <> target_product_id)))),
    CONSTRAINT product_slug_routes_route_kind_check CHECK ((route_kind = ANY (ARRAY['canonical'::text, 'rename'::text, 'replacement'::text]))),
    CONSTRAINT product_slug_routes_source_slug_check CHECK (((source_slug = btrim(source_slug)) AND (source_slug ~ '^[a-z0-9]+(-[a-z0-9]+)*$'::text) AND (char_length(source_slug) <= 120)))
);

CREATE TABLE public.product_sources (
    product_id uuid NOT NULL,
    supplier text NOT NULL,
    supplier_title text NOT NULL,
    supplier_url text NOT NULL,
    supplier_handle text NOT NULL,
    supplier_product_id text,
    source_inspected_at timestamp with time zone NOT NULL,
    source_content_hash text,
    original_source_price_cents integer,
    formulation_version_notes text,
    raw_source jsonb DEFAULT '{}'::jsonb NOT NULL,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT product_sources_original_source_price_cents_check CHECK (((original_source_price_cents IS NULL) OR (original_source_price_cents >= 0)))
);

CREATE TABLE public.product_variants (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    product_id uuid NOT NULL,
    variant_key text NOT NULL,
    label text NOT NULL,
    price_cents integer NOT NULL,
    sku text,
    supplier_variant_id text,
    option_values jsonb DEFAULT '{}'::jsonb NOT NULL,
    compare_at_price_cents integer,
    available boolean DEFAULT true NOT NULL,
    inventory_status text DEFAULT 'in_stock'::text NOT NULL,
    volume text,
    pack_count integer,
    sort_order integer NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    archived_at timestamp with time zone,
    CONSTRAINT product_variants_compare_at_price_cents_check CHECK (((compare_at_price_cents IS NULL) OR (compare_at_price_cents >= 0))),
    CONSTRAINT product_variants_inventory_status_check CHECK ((inventory_status = ANY (ARRAY['in_stock'::text, 'low_stock'::text, 'out_of_stock'::text, 'unavailable'::text]))),
    CONSTRAINT product_variants_pack_count_check CHECK (((pack_count IS NULL) OR (pack_count > 0))),
    CONSTRAINT product_variants_price_cents_check CHECK ((price_cents >= 0))
);

CREATE TABLE public.products (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    slug text NOT NULL,
    benefits text[] DEFAULT '{}'::text[] NOT NULL,
    swatch_from text NOT NULL,
    swatch_to text NOT NULL,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    status text DEFAULT 'available'::text NOT NULL,
    made_for text,
    good_for text,
    texture text,
    product_type text NOT NULL,
    catalog_status text DEFAULT 'active'::text NOT NULL,
    badge text,
    currency text DEFAULT 'USD'::text NOT NULL,
    sort_order integer NOT NULL,
    published_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    key_ingredients text[] DEFAULT '{}'::text[] NOT NULL,
    ingredients text,
    cautions text[] DEFAULT '{}'::text[] NOT NULL,
    finish text,
    volume text,
    skin_types text[] DEFAULT '{}'::text[] NOT NULL,
    concerns text[] DEFAULT '{}'::text[] NOT NULL,
    usage_time text[] DEFAULT '{}'::text[] NOT NULL,
    seo_title text,
    seo_description text,
    search_keywords text[] DEFAULT '{}'::text[] NOT NULL,
    display_name text NOT NULL,
    editorial_description text NOT NULL,
    editorial_how_to_use text NOT NULL,
    formula_notes text[] DEFAULT '{}'::text[] NOT NULL,
    routine_group text NOT NULL,
    routine_sort integer NOT NULL,
    system_step_name text,
    CONSTRAINT products_active_system_step_check CHECK (((catalog_status <> 'active'::text) OR (system_step_name IS NOT NULL))),
    CONSTRAINT products_catalog_status_check CHECK ((catalog_status = ANY (ARRAY['draft'::text, 'active'::text, 'archived'::text]))),
    CONSTRAINT products_currency_check CHECK ((currency = 'USD'::text)),
    CONSTRAINT products_routine_group_check CHECK (((routine_group IS NULL) OR (routine_group = ANY (ARRAY['core'::text, 'beyond_core'::text])))),
    CONSTRAINT products_slug_length_check CHECK ((char_length(slug) <= 120)),
    CONSTRAINT products_status_check CHECK ((status = ANY (ARRAY['available'::text, 'coming_soon'::text, 'sold_out'::text, 'waitlist'::text])))
);

CREATE TABLE public.profiles (
    user_id uuid NOT NULL,
    first_name text,
    last_name text,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT profiles_first_name_length CHECK (((first_name IS NULL) OR (char_length(first_name) <= 80))),
    CONSTRAINT profiles_last_name_length CHECK (((last_name IS NULL) OR (char_length(last_name) <= 80)))
);

CREATE TABLE public.referral_attributions (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    referral_code_id uuid NOT NULL,
    referrer_user_id uuid NOT NULL,
    referee_user_id uuid,
    order_id uuid,
    status public.referral_status DEFAULT 'pending'::public.referral_status NOT NULL,
    source_key text NOT NULL,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    qualified_at timestamp with time zone,
    CONSTRAINT referral_attributions_not_self CHECK (((referee_user_id IS NULL) OR (referee_user_id <> referrer_user_id)))
);

CREATE TABLE public.referral_codes (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    user_id uuid NOT NULL,
    code text NOT NULL,
    active boolean DEFAULT true NOT NULL,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT referral_codes_format CHECK ((code ~ '^[A-Z0-9]{6,16}$'::text))
);

CREATE TABLE public.referral_rewards (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    user_id uuid NOT NULL,
    referral_attribution_id uuid NOT NULL,
    status public.referral_reward_status DEFAULT 'available'::public.referral_reward_status NOT NULL,
    discount_percent integer DEFAULT 15 NOT NULL,
    minimum_subtotal_cents integer DEFAULT 5000 NOT NULL,
    source_key text NOT NULL,
    consumed_order_id uuid,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    consumed_at timestamp with time zone,
    CONSTRAINT referral_rewards_discount CHECK ((discount_percent = 15)),
    CONSTRAINT referral_rewards_minimum CHECK ((minimum_subtotal_cents = 5000))
);

CREATE TABLE public.rewards_accounts (
    user_id uuid NOT NULL,
    points_balance integer DEFAULT 0 NOT NULL,
    lifetime_points integer DEFAULT 0 NOT NULL,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT rewards_accounts_points_nonnegative CHECK (((points_balance >= 0) AND (lifetime_points >= 0)))
);

CREATE TABLE public.rewards_ledger_entries (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    user_id uuid NOT NULL,
    order_id uuid,
    entry_type public.rewards_ledger_entry_type NOT NULL,
    status public.rewards_ledger_status DEFAULT 'posted'::public.rewards_ledger_status NOT NULL,
    points integer NOT NULL,
    description text NOT NULL,
    source_key text NOT NULL,
    metadata jsonb DEFAULT '{}'::jsonb NOT NULL,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT rewards_ledger_points_not_zero CHECK ((points <> 0)),
    CONSTRAINT rewards_ledger_posted_source_present CHECK ((char_length(source_key) > 8))
);

CREATE TABLE public.rewards_reservations (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    user_id uuid NOT NULL,
    order_id uuid,
    status public.rewards_reservation_status DEFAULT 'pending'::public.rewards_reservation_status NOT NULL,
    points integer NOT NULL,
    amount_cents integer NOT NULL,
    source_key text NOT NULL,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT rewards_reservations_amounts_positive CHECK (((points > 0) AND (amount_cents > 0)))
);

CREATE TABLE public.stripe_customers (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    user_id uuid NOT NULL,
    stripe_customer_id text NOT NULL,
    checkout_environment public.checkout_environment DEFAULT 'sandbox'::public.checkout_environment NOT NULL,
    email text,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT stripe_customers_sandbox_only CHECK ((checkout_environment = 'sandbox'::public.checkout_environment))
);

CREATE TABLE public.stripe_webhook_events (
    stripe_event_id text NOT NULL,
    type text NOT NULL,
    livemode boolean DEFAULT false NOT NULL,
    checkout_environment public.checkout_environment DEFAULT 'sandbox'::public.checkout_environment NOT NULL,
    payload jsonb NOT NULL,
    processed_at timestamp with time zone,
    processing_error text,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT stripe_webhook_events_no_live_events CHECK ((livemode = false)),
    CONSTRAINT stripe_webhook_events_sandbox_only CHECK ((checkout_environment = 'sandbox'::public.checkout_environment))
);

CREATE TABLE public.system_steps (
    name text NOT NULL,
    "position" smallint NOT NULL,
    routine_group text NOT NULL,
    CONSTRAINT system_steps_fixed_contract_check CHECK ((((name = 'CLEANSE'::text) AND ("position" = 1) AND (routine_group = 'core'::text)) OR ((name = 'REFINE'::text) AND ("position" = 2) AND (routine_group = 'beyond_core'::text)) OR ((name = 'TREAT'::text) AND ("position" = 3) AND (routine_group = 'core'::text)) OR ((name = 'FRAME'::text) AND ("position" = 4) AND (routine_group = 'beyond_core'::text)) OR ((name = 'SEAL'::text) AND ("position" = 5) AND (routine_group = 'core'::text)) OR ((name = 'PROTECT'::text) AND ("position" = 6) AND (routine_group = 'beyond_core'::text)) OR ((name = 'LIFT'::text) AND ("position" = 7) AND (routine_group = 'beyond_core'::text)))),
    CONSTRAINT system_steps_name_check CHECK ((name = ANY (ARRAY['CLEANSE'::text, 'REFINE'::text, 'TREAT'::text, 'FRAME'::text, 'SEAL'::text, 'PROTECT'::text, 'LIFT'::text]))),
    CONSTRAINT system_steps_position_check CHECK ((("position" >= 1) AND ("position" <= 7))),
    CONSTRAINT system_steps_routine_group_check CHECK ((routine_group = ANY (ARRAY['core'::text, 'beyond_core'::text])))
);

CREATE TABLE public.trustpilot_invitation_attempts (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    order_id uuid,
    user_id uuid,
    status public.trustpilot_invitation_status DEFAULT 'blocked_private_feedback_only'::public.trustpilot_invitation_status NOT NULL,
    blocked_reason text DEFAULT 'helix does not incentivize or send Trustpilot review invitations from rewards flows.'::text NOT NULL,
    metadata jsonb DEFAULT '{}'::jsonb NOT NULL,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT trustpilot_invitation_attempts_blocked_only CHECK ((status = 'blocked_private_feedback_only'::public.trustpilot_invitation_status))
);

