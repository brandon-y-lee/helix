CREATE TABLE private.marketing_contact_imports (
    subscriber_id uuid NOT NULL,
    generation bigint NOT NULL,
    confirmation_revision bigint NOT NULL,
    admission_token uuid DEFAULT extensions.gen_random_uuid() NOT NULL,
    topic_id text NOT NULL,
    provider_import_id uuid,
    first_failure jsonb,
    state text NOT NULL,
    attempt_count integer DEFAULT 1 NOT NULL,
    attempt_started_at timestamp with time zone DEFAULT clock_timestamp() NOT NULL,
    next_submission_at timestamp with time zone,
    admitted_at timestamp with time zone DEFAULT clock_timestamp() NOT NULL,
    next_poll_at timestamp with time zone DEFAULT clock_timestamp() NOT NULL,
    poll_lease_token uuid,
    poll_lease_expires_at timestamp with time zone,
    completed_at timestamp with time zone,
    updated_at timestamp with time zone DEFAULT clock_timestamp() NOT NULL,
    CONSTRAINT marketing_contact_imports_attempt_count_check CHECK (((attempt_count >= 1) AND (attempt_count <= 3))),
    CONSTRAINT marketing_contact_imports_check CHECK (((poll_lease_token IS NULL) = (poll_lease_expires_at IS NULL))),
    CONSTRAINT marketing_contact_imports_check1 CHECK (((state <> ALL (ARRAY['submitted'::text, 'completed'::text, 'failed'::text])) OR (provider_import_id IS NOT NULL))),
    CONSTRAINT marketing_contact_imports_check2 CHECK (((state = 'retry_wait'::text) = (next_submission_at IS NOT NULL))),
    CONSTRAINT marketing_contact_imports_check3 CHECK (((state <> ALL (ARRAY['retry_wait'::text, 'exhausted'::text])) OR (provider_import_id IS NULL))),
    CONSTRAINT marketing_contact_imports_first_failure_check CHECK (private.valid_marketing_import_failure(first_failure)),
    CONSTRAINT marketing_contact_imports_state_check CHECK ((state = ANY (ARRAY['admitted'::text, 'submitted'::text, 'uncertain'::text, 'retry_wait'::text, 'exhausted'::text, 'completed'::text, 'failed'::text])))
);

