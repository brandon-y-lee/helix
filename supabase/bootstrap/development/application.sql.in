CREATE TABLE private.email_intents (
    id uuid DEFAULT extensions.gen_random_uuid() NOT NULL,
    environment text NOT NULL,
    purpose text NOT NULL,
    order_id uuid,
    recipient text,
    receipt jsonb,
    state text NOT NULL,
    idempotency_key text NOT NULL,
    request_payload jsonb,
    first_attempt_at timestamp with time zone,
    attempt_count integer DEFAULT 0 NOT NULL,
    lease_token uuid,
    lease_expires_at timestamp with time zone,
    next_attempt_at timestamp with time zone DEFAULT clock_timestamp() NOT NULL,
    provider_email_id text,
    delivery_status text,
    delivery_occurred_at timestamp with time zone,
    error_code text,
    created_at timestamp with time zone DEFAULT clock_timestamp() NOT NULL,
    updated_at timestamp with time zone DEFAULT clock_timestamp() NOT NULL,
    content_deleted_at timestamp with time zone,
    tracking_event_id uuid,
    synthetic_at timestamp with time zone,
    CONSTRAINT email_intents_attempt_count_check CHECK (((attempt_count >= 0) AND (attempt_count <= 5))),
    CONSTRAINT email_intents_check CHECK (((lease_token IS NULL) = (lease_expires_at IS NULL))),
    CONSTRAINT email_intents_check1 CHECK ((((first_attempt_at IS NULL) = (request_payload IS NULL)) OR (content_deleted_at IS NOT NULL))),
    CONSTRAINT email_intents_check2 CHECK (((content_deleted_at IS NULL) OR ((recipient IS NULL) AND (receipt IS NULL) AND (request_payload IS NULL)))),
    CONSTRAINT email_intents_delivery_status_check CHECK ((delivery_status = ANY (ARRAY['sent'::text, 'delayed'::text, 'delivered'::text, 'bounced'::text, 'complained'::text, 'suppressed'::text, 'failed'::text]))),
    CONSTRAINT email_intents_environment_check CHECK ((environment = 'sandbox'::text)),
    CONSTRAINT email_intents_error_code_check CHECK (((error_code IS NULL) OR (error_code ~ '^[a-z][a-z0-9_]{0,63}$'::text))),
    CONSTRAINT email_intents_order_purpose_check CHECK (((purpose = ANY (ARRAY['order_confirmation'::text, 'order_tracking'::text])) = (order_id IS NOT NULL))),
    CONSTRAINT email_intents_purpose_check CHECK ((purpose = ANY (ARRAY['order_confirmation'::text, 'order_tracking'::text, 'support_acknowledgement'::text, 'support_reply'::text, 'marketing_confirmation'::text, 'welcome_initial'::text, 'welcome_education'::text, 'product_availability'::text, 'product_waitlist_recovery'::text]))),
    CONSTRAINT email_intents_receipt_check CHECK (((receipt IS NULL) OR (jsonb_typeof(receipt) = 'object'::text))),
    CONSTRAINT email_intents_request_payload_check CHECK (((request_payload IS NULL) OR (jsonb_typeof(request_payload) = 'object'::text))),
    CONSTRAINT email_intents_state_check CHECK ((state = ANY (ARRAY['queued'::text, 'leased'::text, 'retry'::text, 'accepted'::text, 'blocked'::text, 'unsendable'::text, 'uncertain'::text, 'failed'::text]))),
    CONSTRAINT email_intents_tracking_event_check CHECK (((purpose = 'order_tracking'::text) = (tracking_event_id IS NOT NULL)))
);

ALTER TABLE ONLY private.email_intents FORCE ROW LEVEL SECURITY;

