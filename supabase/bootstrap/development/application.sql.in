CREATE TABLE private.support_inquiries (
    id uuid DEFAULT extensions.gen_random_uuid() NOT NULL,
    revision integer DEFAULT 1 NOT NULL,
    status text DEFAULT 'open'::text NOT NULL,
    closed_at timestamp with time zone,
    name text NOT NULL,
    email text NOT NULL,
    inquiry_type text NOT NULL,
    subject text NOT NULL,
    order_id uuid,
    current_draft_version integer DEFAULT 0 NOT NULL,
    created_at timestamp with time zone DEFAULT clock_timestamp() NOT NULL,
    updated_at timestamp with time zone DEFAULT clock_timestamp() NOT NULL,
    redacted_at timestamp with time zone,
    retention_completed_at timestamp with time zone,
    retention_checked_at timestamp with time zone,
    synthetic_at timestamp with time zone,
    retention_hold_until timestamp with time zone,
    retention_hold_reason text,
    retention_hold_actor_id uuid,
    CONSTRAINT support_inquiries_check CHECK (((status = 'closed'::text) = (closed_at IS NOT NULL))),
    CONSTRAINT support_inquiries_created_at_check CHECK (isfinite(created_at)),
    CONSTRAINT support_inquiries_current_draft_version_check CHECK ((current_draft_version >= 0)),
    CONSTRAINT support_inquiries_email_check CHECK (((length(email) >= 3) AND (length(email) <= 254))),
    CONSTRAINT support_inquiries_inquiry_type_check CHECK ((inquiry_type = ANY (ARRAY['product'::text, 'routine'::text, 'account'::text, 'cart'::text, 'accessibility'::text, 'privacy'::text, 'partnership'::text, 'wholesale'::text, 'general'::text]))),
    CONSTRAINT support_inquiries_name_check CHECK (((length(name) >= 1) AND (length(name) <= 100))),
    CONSTRAINT support_inquiries_retention_hold_reason_check CHECK ((retention_hold_reason = ANY (ARRAY['safety'::text, 'legal'::text]))),
    CONSTRAINT support_inquiries_revision_check CHECK ((revision > 0)),
    CONSTRAINT support_inquiries_status_check CHECK ((status = ANY (ARRAY['open'::text, 'closed'::text]))),
    CONSTRAINT support_inquiries_subject_check CHECK (((length(subject) >= 1) AND (length(subject) <= 200))),
    CONSTRAINT support_retention_hold_check CHECK ((((retention_hold_until IS NULL) AND (retention_hold_reason IS NULL) AND (retention_hold_actor_id IS NULL)) OR ((retention_hold_until IS NOT NULL) AND isfinite(retention_hold_until) AND (retention_hold_reason IS NOT NULL) AND (retention_hold_actor_id IS NOT NULL))))
);

