CREATE INDEX checkout_create_receipts_order_idx ON private.checkout_create_receipts USING btree (order_id);

CREATE INDEX checkout_payment_contracts_order_idx ON private.checkout_payment_contracts USING btree (order_id);

CREATE INDEX checkout_payment_exceptions_unresolved_idx ON private.checkout_payment_exceptions USING btree (order_id, session_id, updated_at DESC) WHERE (resolved_at IS NULL);

CREATE INDEX checkout_receipt_capabilities_cohort_idx ON private.checkout_receipt_capabilities USING btree (cohort_id);

CREATE INDEX checkout_receipt_cohorts_owner_idx ON private.checkout_receipt_cohorts USING btree (account_id, guest_owner_hash, expires_at);

CREATE INDEX checkout_receipt_grants_token_idx ON private.checkout_receipt_grants USING btree (token_hash);

CREATE INDEX checkout_receipt_order_windows_owner_idx ON private.checkout_receipt_order_windows USING btree (account_id, guest_owner_hash, expires_at);

CREATE INDEX email_event_receipts_message_idx ON private.email_event_receipts USING btree (message_id, received_at);

CREATE UNIQUE INDEX email_intents_confirmation_identity ON private.email_intents USING btree (environment, purpose, order_id) WHERE (purpose = 'order_confirmation'::text);

CREATE INDEX email_intents_dispatch_idx ON private.email_intents USING btree (environment, next_attempt_at, created_at) WHERE ((state = ANY (ARRAY['queued'::text, 'retry'::text, 'uncertain'::text, 'leased'::text])) AND (content_deleted_at IS NULL));

CREATE INDEX email_intents_lease_idx ON private.email_intents USING btree (lease_expires_at) WHERE (lease_token IS NOT NULL);

