    accepted_at timestamp with time zone[] DEFAULT '{}'::timestamp with time zone[] NOT NULL,
    CONSTRAINT checkout_receipt_budgets_accepted_at_check CHECK ((cardinality(accepted_at) <= 10)),
    CONSTRAINT checkout_receipt_budgets_account_id_check CHECK ((account_id = 'acct_1Tm9WRFEzyaKzdmq'::text))
);

ALTER TABLE ONLY private.checkout_receipt_budgets FORCE ROW LEVEL SECURITY;

CREATE TABLE private.checkout_receipt_capabilities (
    token_hash text NOT NULL,
    account_id text NOT NULL,
    cohort_id uuid NOT NULL,
    created_at timestamp with time zone NOT NULL,
    expires_at timestamp with time zone NOT NULL,
    revoked_at timestamp with time zone,
    CONSTRAINT checkout_receipt_capabilities_account_id_check CHECK ((account_id = 'acct_1Tm9WRFEzyaKzdmq'::text)),
    CONSTRAINT checkout_receipt_capabilities_check CHECK (((expires_at > created_at) AND (expires_at <= (created_at + '24:00:00'::interval)))),
    CONSTRAINT checkout_receipt_capabilities_token_hash_check CHECK ((token_hash ~ '^[a-f0-9]{64}$'::text))
);

ALTER TABLE ONLY private.checkout_receipt_capabilities FORCE ROW LEVEL SECURITY;

CREATE TABLE private.checkout_receipt_cohorts (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    account_id text NOT NULL,
    environment public.checkout_environment DEFAULT 'sandbox'::public.checkout_environment NOT NULL,
    guest_owner_hash text NOT NULL,
    created_at timestamp with time zone NOT NULL,
    expires_at timestamp with time zone NOT NULL,
    CONSTRAINT checkout_receipt_cohorts_account_id_check CHECK ((account_id = 'acct_1Tm9WRFEzyaKzdmq'::text)),
    CONSTRAINT checkout_receipt_cohorts_check CHECK ((expires_at = (created_at + '24:00:00'::interval))),
    CONSTRAINT checkout_receipt_cohorts_environment_check CHECK ((environment = 'sandbox'::public.checkout_environment)),
    CONSTRAINT checkout_receipt_cohorts_guest_owner_hash_check CHECK ((guest_owner_hash ~ '^[a-f0-9]{64}$'::text))
