{
  "name": "helix",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "tsx scripts/verify-production.ts",
    "verify:production": "tsx scripts/verify-production.ts",
    "verify:helix-rebrand": "tsx scripts/verify-helix-rebrand.ts",
    "verify:product-media": "tsx scripts/verify-product-media.ts",
    "github:workflow:plan": "node scripts/github/bootstrap-workflow.mjs plan --repo brandon-y-lee/helix",
    "github:workflow:apply": "node scripts/github/bootstrap-workflow.mjs apply --repo brandon-y-lee/helix",
    "catalog:webhooks:plan": "tsx scripts/catalog-webhooks.ts plan",
    "catalog:webhooks:apply": "tsx scripts/catalog-webhooks.ts apply",
    "catalog:webhooks:verify": "tsx scripts/catalog-webhooks.ts verify",
    "catalog:webhooks:smoke": "tsx scripts/catalog-webhooks.ts smoke",
    "product:search:verify": "tsx scripts/product-search.ts verify",
    "catalog:publish:frame-lift": "tsx scripts/catalog/publish-frame-lift.ts",
    "admin:bootstrap": "tsx scripts/admin-bootstrap.ts",
    "db:carts:cleanup:dry-run": "tsx scripts/db/cleanup-expired-carts.ts --dry-run",
    "db:carts:cleanup:apply": "tsx scripts/db/cleanup-expired-carts.ts --apply",
    "db:rewards:verify": "tsx scripts/db/verify-rewards-contract.ts",
    "db:helix-rebrand:verify": "tsx scripts/db/verify-helix-rebrand-audit.ts",
    "db:types": "pnpm dlx supabase gen types --linked --schema public > lib/database.types.ts",
    "db:verify": "tsx scripts/db/verify-supabase-data.ts",
    "search:backfill": "tsx scripts/search-backfill.ts",
    "search:reindex": "pnpm run search:backfill",
    "stripe:sync:sandbox": "tsx scripts/stripe-sync-sandbox.ts apply",
    "stripe:sandbox:plan": "tsx scripts/stripe-sync-sandbox.ts plan",
    "stripe:sandbox:verify": "tsx scripts/stripe-sync-sandbox.ts verify"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.12.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tanstack/react-query": "5.101.4",
    "algoliasearch": "^5",
    "motion": "^12.43.0",
    "next": "15.5.19",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "stripe": "^22.3.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "20.17.30",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "4.4.1",
    "dotenv": "^17.4.2",
    "eslint": "9.25.1",
    "eslint-config-next": "15.5.19",
    "jsdom": "26.1.0",
    "tsx": "^4.22.4",
    "typescript": "5.8.3",
    "vitest": "3.2.6"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1"
    }
  }
}
