{
  "name": "mei-pelle",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0 <21"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "catalog:import:leaders": "tsx scripts/catalog-import-leaders.ts",
    "catalog:media:sync-core": "tsx scripts/catalog-sync-core-media.ts",
    "catalog:media:sync-core-pdp": "tsx scripts/catalog-sync-core-pdp-media.ts",
    "catalog:media:sync-core-gallery": "tsx scripts/catalog-sync-core-pdp-media.ts --roles gallery",
    "catalog:media:sync-outcomes": "tsx scripts/catalog-sync-outcome-media.ts",
    "catalog:media:sync-cleanse-application": "tsx scripts/catalog-sync-cleanse-application-media.ts",
    "catalog:media:reconcile-core-pdp": "tsx scripts/catalog-reconcile-core-pdp-media.ts",
    "catalog:refresh:presentation": "tsx scripts/catalog-refresh-presentation.ts",
    "catalog:webhooks:plan": "tsx scripts/catalog-webhooks.ts plan",
    "catalog:webhooks:apply": "tsx scripts/catalog-webhooks.ts apply",
    "catalog:webhooks:verify": "tsx scripts/catalog-webhooks.ts verify",
    "catalog:webhooks:smoke": "tsx scripts/catalog-webhooks.ts smoke",
    "catalog:verify": "tsx scripts/db/verify-supabase-data.ts",
    "admin:bootstrap": "tsx scripts/admin-bootstrap.ts",
    "db:audit": "tsx scripts/db/audit-supabase-data.ts",
    "db:cleanup:dry-run": "tsx scripts/db/cleanup-supabase-data.ts --dry-run",
    "db:cleanup:apply": "tsx scripts/db/cleanup-supabase-data.ts --apply",
    "db:carts:cleanup:dry-run": "tsx scripts/db/cleanup-expired-carts.ts --dry-run",
    "db:carts:cleanup:apply": "tsx scripts/db/cleanup-expired-carts.ts --apply",
    "db:types": "pnpm dlx supabase gen types --linked --schema public > lib/database.types.ts",
    "db:verify": "tsx scripts/db/verify-supabase-data.ts",
    "search:backfill": "tsx scripts/search-backfill.ts",
    "search:verify-core-pdp-media": "tsx scripts/search-verify-core-pdp-media.ts",
    "search:reindex": "pnpm run search:backfill",
    "stripe:sync:sandbox": "tsx scripts/stripe-sync-sandbox.ts",
    "test:cart:concurrency": "tsx scripts/test-cart-concurrency.ts"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.12.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tanstack/react-query": "5.101.4",
    "algoliasearch": "^5",
    "motion": "^12.43.0",
    "next": "15.5.19",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "stripe": "^22.3.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "20.17.30",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "4.4.1",
    "dotenv": "^17.4.2",
    "eslint": "9.25.1",
    "eslint-config-next": "15.5.19",
    "jsdom": "26.1.0",
    "tsx": "^4.22.4",
    "typescript": "5.8.3",
    "vitest": "3.2.6"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1"
    }
  }
}
